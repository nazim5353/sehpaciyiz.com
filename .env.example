# Yerel onizleme icin .env.local dosyasina kopyalayin.
LOCAL_PREVIEW=true
# Sadece yerelde girissiz panel icin true yapin.
COMPANY_PANEL_PREVIEW=false
# Her ikisi icin ayri 32 byte rastgele deger kullanin.
SESSION_SECRET=
SETTINGS_ENCRYPTION_KEY=
# Sirket sahibi hesabini /yonetim/giris ekranindan olusturun.
# Yerel panel verisi .local/company-pg klasorunde tutulur.
# DATABASE_URL henuz kullanilmayan canli PostgreSQL taslagi icindir.
DATABASE_URL=postgresql://user:password@localhost:5432/sehpaciyiz
