// Production schema draft. No migration has been applied and the local adapter
// does not use this schema yet. Monetary values are integer minor units (kurus).
generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum FulfillmentType {
  STOCK
  MADE_TO_ORDER
}
enum OrderStatus {
  PAYMENT_PENDING
  CONFIRMED
  IN_PRODUCTION
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}
enum PaymentStatus {
  PENDING
  PROCESSING
  UNDER_REVIEW
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  sort Int @default(0)
  products Product[]
  @@map("categories")
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug String @unique
  name String
  description String
  priceMinor Int
  currency String @default("TRY") @db.Char(3)
  previousPriceMinor Int?
  active Boolean @default(false)
  featured Boolean @default(false)
  images Json @default("[]")
  specifications Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  variants ProductVariant[]
  @@index([categoryId, active])
  @@map("products")
}
model ProductVariant {
  id String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku String @unique
  name String
  color String?
  surchargeMinor Int @default(0)
  stock Int @default(0)
  fulfillment FulfillmentType
  leadDays Int
  productionProductId String?
  reservations StockReservation[]
  orderItems OrderItem[]
  @@index([productId])
  @@map("product_variants")
}
model Customer {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  phone String?
  passwordHash String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  orders Order[]
  @@map("customers")
}
model Order {
  id String @id @default(uuid()) @db.Uuid
  number String @unique
  customerId String? @db.Uuid
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status OrderStatus @default(PAYMENT_PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  currency String @default("TRY") @db.Char(3)
  subtotalMinor Int
  discountMinor Int @default(0)
  shippingMinor Int
  totalMinor Int
  customerSnapshot Json
  shippingSnapshot Json
  billingSnapshot Json
  agreementVersion String
  agreementAcceptedAt DateTime @db.Timestamptz(3)
  estimatedReadyAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  items OrderItem[]
  reservations StockReservation[]
  payments PaymentAttempt[]
  shipments Shipment[]
  refunds Refund[]
  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("orders")
}
model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  nameSnapshot String
  variantSnapshot Json
  unitPriceMinor Int
  discountMinor Int @default(0)
  quantity Int
  fulfillment FulfillmentType
  paymentTransactionId String? @unique
  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}
model StockReservation {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId String @db.Uuid
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity Int
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  releasedAt DateTime? @db.Timestamptz(3)
  @@index([orderId])
  @@index([variantId, expiresAt])
  @@map("stock_reservations")
}
model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  provider String @default("iyzico")
  providerTokenEncrypted String?
  providerPaymentId String? @unique
  status PaymentStatus @default(PENDING)
  expectedAmountMinor Int
  chargedAmountMinor Int?
  currency String @db.Char(3)
  fraudStatus Int?
  errorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([orderId])
  @@map("payment_attempts")
}
model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  providerEventId String
  payloadHash String
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  @@unique([provider, providerEventId])
  @@index([processedAt, receivedAt])
  @@map("webhook_events")
}
model Shipment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  carrier String
  providerShipmentId String? @unique
  trackingNumber String?
  status String
  packageSnapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId])
  @@map("shipments")
}
model Refund {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey String @unique
  providerRefundId String? @unique
  status String
  amountMinor Int
  itemSnapshot Json
  reason String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([orderId])
  @@map("refunds")
}
model StoreSetting {
  section String @id
  publicValues Json @default("{}")
  encryptedSecrets String?
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@map("store_settings")
}
model IntegrationJob {
  id String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique
  type String
  status JobStatus @default(PENDING)
  payloadEncrypted String
  attempts Int @default(0)
  runAfter DateTime @default(now()) @db.Timestamptz(3)
  lastErrorCode String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([status, runAfter])
  @@map("integration_jobs")
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String
  action String
  target String
  redactedChanges Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([target, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
